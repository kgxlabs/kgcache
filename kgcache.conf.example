# kgcache.conf.example
#
# Every directive below is commented out and set to its built-in default
# (see Config.default() in src/config.zig). Uncomment a line and change its
# value to override that default; anything left commented out (or left out
# of your own config file entirely) keeps the default.
#
# Format: one directive per line, `directive value`. Blank lines and lines
# starting with `#` are ignored. Anything else must be a recognized
# directive with a value -- an unknown directive, a missing value, or a
# value that doesn't fit the directive's type all fail the server at
# startup with a message on stderr, rather than being silently ignored.
#
# Run with: ./zig-out/bin/kgcache path/to/kgcache.conf

# Address the TCP server binds to.
# bind 127.0.0.1

# TCP port the server listens on.
# port 6379

# Whether to set SO_REUSEADDR on the listening socket, which lets the
# server rebind quickly on restart instead of waiting for the OS to
# release the previous socket. yes or no.
# reuse-address yes

# Size, in bytes, of the per-connection read buffer. A request (or a
# pipelined batch of requests) larger than this is not yet supported.
# connection-buffer-size 1024

# Number of selectable databases: SELECT 0 through num-databases - 1.
# num-databases 16

# Path to the on-disk snapshot file: loaded on startup if it exists, and
# written out by the SAVE command. Must end in `.kgc`. A relative path is
# resolved against the server's current working directory, not this
# config file's location. The parent directory must already exist -- it
# is not created automatically. `~` is not expanded; use an absolute path
# instead of a home-directory shorthand.
# snapshot-path dump.kgc

# How often, in milliseconds, background work runs. This includes active
# expiration, AOF flushing, save checks, and child-process cleanup.
# cron-interval-ms 100

# Time budget, in milliseconds, the active-expiration worker spends per
# sweep before yielding, regardless of how many databases still have
# expirable keys left unchecked.
# active-expire-budget-ms 10

# Number of keys sampled per expiration batch, per database, before
# deciding whether to keep going or move to the next database.
# active-expire-batch-size 20

# If at least this percentage of a batch came back expired, immediately
# run another batch on the same database instead of moving on.
# active-expire-threshold-percent 25

# Prevent BGSAVE and BGREWRITEAOF from running at the same time. Keeping
# this on lowers memory use while a background child is running.
# exclusive-bg-persistence yes

# One or more rules for automatically triggering a background save
# (equivalent to BGSAVE) when enough writes have happened recently.
# Format: save <seconds> <changes> -- trigger if at least <changes>
# writes happened in the last <seconds> seconds since the last save.
# This directive may be repeated; if ANY rule's condition is met, a
# background save is triggered. With no `save` line at all (the
# default), automatic saving is disabled -- SAVE/BGSAVE still work
# on demand.
# save 3600 1
# save 300 100
# save 60 10000

# Write each data change to an append-only file. yes or no.
# appendonly no

# AOF fsync policy: always, everysec, or no.
# appendfsync everysec

# Directory that holds AOF files. It is relative to the process working
# directory. kgcache owns this directory; do not store other files in it.
# append-dirname appendonlydir

# Base name used to build AOF data and manifest file names.
# append-filename appendonly.aof

# Rewrite the AOF after incremental data grows by this percentage.
# Set 0 to turn off automatic rewrites. Manual BGREWRITEAOF still works.
# auto-aof-rewrite-percentage 100

# Do not start an automatic rewrite until the total AOF size reaches this
# many bytes. Values such as "64mb" are not accepted.
# auto-aof-rewrite-min-size 67108864

# If the last incremental file ends with an incomplete command, remove
# that command and continue loading. yes or no.
# aof-load-truncated yes
