{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "strict": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "isolatedModules": true,
    "paths": { "@/*": ["./*.ts"] },
    "types": ["node"]
  },
  "include": ["run.ts", "run.test.ts", "eslint.config.ts", "harness/**/*.ts"],
  "exclude": ["harness/**/*.test.ts"]
}
