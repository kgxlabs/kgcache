# Only the server build graph and image assets enter the build context.
**
!Dockerfile
!.dockerignore
!build.zig
!build.zig.zon
!src/
!src/**
!tools/
!tools/release/
!tools/release/common.sh
!tools/release/settings.sh
!tools/release/zig.sh
!tools/release/create-build-info.jq
!tools/container/
!tools/container/build.sh
!containers/
!containers/kgcache.conf
**/.git
**/.zig-cache
**/zig-out
**/node_modules
**/.client-tools
**/test-artifacts
**/.workspaces
**/.env*
**/.aws
**/.ssh
**/*.kgc
**/appendonlydir
